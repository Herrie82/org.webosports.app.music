description "Music+Spotify backend (Spotify search + Connect playback control)"

# Start once the UI is up (media partition + network are ready by then).
start on started LunaSysMgr
stop on stopping LunaSysMgr

# Restart if it ever dies.
respawn

# The backend + librespot + log + cache + all token/credential files live under
# /media/cryptofs/spotify-webos (see service/paths.go). NOT /media/internal: that vfat
# partition is exported in USB drive mode, and a binary/log/open-fd there blocks the
# unmount ("USB drive Connection failed"). cryptofs is only suspended (not unmounted)
# for MSM and persists across reboots. It reads the client id from
# /media/cryptofs/spotify-webos/spotify-client-id (see -client-id-file).
exec /media/cryptofs/spotify-webos/spotify-webos-service -addr 127.0.0.1:8730
